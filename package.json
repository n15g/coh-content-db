{
  "name": "coh-content-db",
  "version": "2.3.0",
  "description": "City of Heroes Content Database",
  "homepage": "https://github.com/n15g/coh-content-db#readme",
  "bugs": {
    "url": "https://github.com/n15g/coh-content-db/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/n15g/coh-content-db.git"
  },
  "license": "Unlicense",
  "author": "N15g",
  "files": [
    "dist",
    "CHANGELOG.md",
    "LICENSE",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/coh-content-db.d.ts",
      "import": "./dist/coh-content-db.mjs",
      "require": "./dist/coh-content-db.js"
    }
  },
  "main": "dist/coh-content-db.js",
  "module": "dist/coh-content-db.mjs",
  "types": "dist/coh-content-db.d.ts",
  "scripts": {
    "build": "rollup --config",
    "lint": "eslint",
    "test": "jest --coverage",
    "typecheck": "tsc --noEmit",
    "validate": "npm run lint && npm run typecheck && npm run test && npm run build",
    "push": "git push && git push --tags",
    "watch": "rollup --config --watch"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/jest": "^30.0.0",
    "efate": "^1.5.1",
    "eslint": "^10.8.1",
    "eslint-plugin-unicorn": "^73.0.0",
    "globals": "^17.9.0",
    "jest": "^30.4.2",
    "rollup": "^4.62.4",
    "rollup-plugin-dts": "^6.5.1",
    "rollup-plugin-esbuild": "^6.2.1",
    "ts-jest": "^29.4.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0"
  },
  "engines": {
    "node": ">=24"
  }
}
